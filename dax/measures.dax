// ============================================================
// The Look E-commerce – DAX measures used in the Power BI report
// ============================================================

// ---------- Sales & product performance (table: order_items) ----------

Total Revenue =
SUM ( order_items[sale_price] )

Total Cost =
SUMX ( order_items, RELATED ( products[cost] ) )

Margin =
[Total Revenue] - [Total Cost]

// ---------- Report measures (table: _Measures) ----------

Total Margin =
[Total Revenue] - [Total Cost]

Avg Margin % =
DIVIDE ( [Total Margin], [Total Revenue] )

// Share of order items with status "Returned"
Return Rate =
DIVIDE (
    CALCULATE ( COUNTROWS ( order_items ), order_items[status] = "Returned" ),
    COUNTROWS ( order_items )
)

// ---------- Customer measures (table: _Measures) ----------

Registered Users =
DISTINCTCOUNT ( users[id] )

Avg Spend =
AVERAGE ( users[Total Spend] )

Avg Orders =
AVERAGE ( users[Order Count] )

Avg Recency =
FORMAT ( AVERAGE ( users[Recency Days] ), "0" ) & " Days"

// Share of buyers (users with at least one order) in the 'Champions' segment
Champions % =
DIVIDE (
    CALCULATE ( COUNTROWS ( users ), users[RFM Segment] = "Champions" ),
    CALCULATE ( COUNTROWS ( users ), users[RFM Segment] <> "No purchase" )
)

// Share of buyers who ordered exactly once
One-time Buyers % =
DIVIDE (
    CALCULATE ( COUNTROWS ( users ), users[Order Count] = 1 ),
    CALCULATE ( COUNTROWS ( users ), NOT ISBLANK ( users[Order Count] ) )
)
